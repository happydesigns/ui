{
  "name": "@happydesigns/ui",
  "type": "module",
  "version": "0.20.2",
  "private": false,
  "packageManager": "pnpm@11.11.0",
  "description": "A reusable Nuxt foundation for content-driven happydesigns websites and applications.",
  "author": "happydesigns",
  "homepage": "https://github.com/happydesigns/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happydesigns/ui.git"
  },
  "bugs": {
    "url": "https://github.com/happydesigns/ui/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-layer",
    "nuxt-ui",
    "nuxt-content",
    "vue",
    "design-system",
    "content-management"
  ],
  "exports": {
    ".": "./nuxt.config.ts",
    "./schemas": "./schemas/index.ts",
    "./styles.css": "./app/assets/css/styles.css",
    "./types": "./app/types/config.ts",
    "./content": "./content/nuxt.config.ts"
  },
  "main": "./nuxt.config.ts",
  "files": [
    "app",
    "content",
    "nuxt.config.ts",
    "schemas",
    "server",
    "shared"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "nuxt dev playground",
    "docs": "nuxt dev docs",
    "docs:build": "nuxt generate docs && node scripts/validate-docs-output.mjs",
    "docs:build:server": "nuxt build docs",
    "docs:typecheck:server": "nuxt prepare docs && tsc --noEmit --project docs/tsconfig.server.json",
    "prepare": "nuxt prepare && nuxt prepare playground",
    "build": "nuxt build playground && node scripts/validate-playground-output.mjs",
    "generate": "nuxt generate playground && node scripts/validate-playground-output.mjs",
    "consumer:check": "node scripts/validate-consumer.mjs",
    "preview": "nuxt preview playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck && nuxt typecheck playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:preview": "changelogen --no-output",
    "release:check": "node scripts/github-release.mjs --check",
    "release": "changelogen --release --no-github --clean",
    "release:pre": "changelogen --release --prerelease --no-github --clean",
    "release:alpha": "changelogen --release --versionSuffix alpha.0 --no-github --clean",
    "release:beta": "changelogen --release --versionSuffix beta.0 --no-github --clean"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.41",
    "vue-router": "^4.6.0 || ^5.0.0"
  },
  "dependencies": {
    "@happydesigns/config-variants": "^0.3.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.152",
    "@iconify-json/simple-icons": "^1.2.101",
    "@nuxt/content": "^3.17.0",
    "@nuxt/ui": "^4.12.2",
    "@vueuse/core": "^14.3.0",
    "better-sqlite3": "^12.11.1",
    "h3": "^1.15.11",
    "nuxt-studio": "^1.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@antfu/ni": "^30.6.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@takumi-rs/core": "1.8.7",
    "changelogen": "^0.6.2",
    "cross-env": "^10.1.0",
    "docus": "5.12.3",
    "eslint": "^10.14.0",
    "nuxt": "4.6.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-router": "5.4.0",
    "vue-tsc": "^3.3.7"
  },
  "resolutions": {
    "@happydesigns/ui": "workspace:*"
  }
}
